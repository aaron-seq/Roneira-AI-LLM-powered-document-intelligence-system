# Static build of the React frontend, served by nginx.
#
# nginx also reverse-proxies /api to the backend container, which is what lets
# the browser talk to the API on the same origin (no CORS preflight, no
# hard-coded API host baked into the bundle).

# ---------------------------------------------------------------- builder
FROM node:20-alpine AS builder

WORKDIR /app

# Dependencies first, so a source-only change reuses the install layer.
COPY package.json package-lock.json ./
# `npm ci` installs exactly what package-lock.json pins. `npm install` was
# free to resolve different versions than CI and the lockfile tested.
RUN npm ci

COPY tsconfig.json vite.config.ts index.html theme.ts ./
COPY src/ ./src/

RUN npm run build

# ------------------------------------------------------------------ nginx
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY deployment/nginx/frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost/ > /dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
