# Copy to .env and adjust. Every variable here is read by
# backend/core/config.py — if it is not listed in that file, it has no effect.
#
# The defaults are tuned for a local run: nothing below is required to start
# the service on a laptop.

# ------------------------------------------------------------------ core
APP_NAME="Roneira Document Intelligence"
# development | test | staging | production
# Setting this to `production` turns on a startup check that refuses unsafe
# configuration (placeholder secret key, disabled auth, wildcard CORS).
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# -------------------------------------------------------------- security
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters in production, and must not be this value.
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Set to false ONLY for a local kick-the-tyres run: it makes every document
# and chat endpoint reachable without a token. Refused in production.
REQUIRE_AUTHENTICATION=true

# Passwords for the built-in development accounts. These are NOT a user
# management system — see docs/SECURITY.md before serving real documents.
DEMO_USER_PASSWORD=demo
ADMIN_USER_PASSWORD=admin123

# Per-client budgets. The second applies to upload, chat and search, which
# each cost a document parse or an LLM inference.
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_EXPENSIVE_PER_MINUTE=20

# -------------------------------------------------------------- database
# SQLite is the zero-setup default and is fine for a single worker.
DATABASE_URL=sqlite+aiosqlite:///./document_intelligence.db
# PostgreSQL (required for more than one worker):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/document_intelligence

# ------------------------------------------------------------------- llm
# Ollama runs locally; no API key, no data leaving the machine.
#   ollama pull llama3.2:3b
# If Ollama is unreachable the service still extracts, indexes and searches
# documents — it just cannot summarise them.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120

# ------------------------------------------------------------- documents
UPLOAD_DIRECTORY=./uploads
PROCESSED_FILES_DIRECTORY=./processed
MAX_FILE_SIZE=52428800

# Keep the original file after processing. Required to open a cited page in
# the source document. Set false where documents must not be retained at rest.
RETAIN_SOURCE_FILES=true
# Delete retained sources older than this many days. 0 disables expiry.
SOURCE_RETENTION_DAYS=30

ENABLE_OCR=true
# Leave blank to auto-detect the tesseract binary.
TESSERACT_PATH=

# ------------------------------------------------------------------- rag
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_PATH=./chroma_db
VECTOR_COLLECTION_NAME=documents
CHUNK_SIZE=1000
# Must be smaller than CHUNK_SIZE; startup fails otherwise.
CHUNK_OVERLAP=200
MAX_CONVERSATION_HISTORY=10
# Chunks below this similarity are not shown as citations.
RETRIEVAL_MIN_SCORE=0.15

# Re-rank the retrieved candidates by combining semantic similarity with
# keyword overlap. Vector search alone is weak on exact tokens — invoice
# numbers, surnames, product codes — where a topically similar passage can
# outrank the one holding the literal term asked for. Set false to rank by
# semantic similarity only.
HYBRID_RETRIEVAL=true

# Re-score the shortlist with a cross-encoder, which reads the question and
# the passage together rather than comparing two vectors computed separately.
# Measured over docs/samples/ this takes recall@1 from 69% to 77% and recall@3
# from 92% to 100% — see scripts/eval_retrieval.py. Costs an ~80MB model
# download on first use and roughly 100ms per query on CPU. If the model
# cannot be loaded, search continues on embedding similarity and says so.
RERANK_RESULTS=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# When true, startup fails unless a real embedding model loads. When false,
# the service falls back to keyword-only matching: it works, but paraphrased
# questions will not find the right passage. Turn this on wherever answer
# quality matters.
REQUIRE_REAL_EMBEDDINGS=false

# ------------------------------------------------------------------ cors
# Comma-separated or a JSON array. Must not be "*" in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Host header allow-list. "*" is the local default and is refused in production.
ALLOWED_HOSTS=*

# --------------------------------------------------------- observability
# Serves Prometheus metrics at /api/metrics.
METRICS_ENABLED=true

# ---------------------------------------------------------------- server
# Gunicorn only. Keep WORKERS=1 unless DATABASE_URL points at PostgreSQL.
# WORKERS=1
# WORKER_TIMEOUT=180
