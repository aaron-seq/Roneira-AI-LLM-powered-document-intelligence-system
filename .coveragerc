# Measure application code. Offline training utilities and optional tracing
# remain outside the gate; include them with tests when wiring them into a
# request path. See docs/ARCHITECTURE.md#unwired-modules.

[run]
source = backend
branch = False
omit =
    backend/tests/*
    # --- Not imported by backend.main (verified, not assumed) ---
    backend/training/*
    # Optional tracing shim; inert unless opentelemetry is installed.
    backend/observability/tracing.py

[report]
show_missing = True
skip_covered = True
precision = 1
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    raise NotImplementedError
    if __name__ == .__main__.:
    \.\.\.

[xml]
output = coverage.xml
